# Technology-independent custom-tree synthesis. Run from repository root.
read_verilog -sv comparator_benchmark/rtl/comparator_tree.sv
hierarchy -check -top comparator_tree
proc
opt
flatten
opt
techmap
opt
abc -g AND,OR,XOR,XNOR,NAND,NOR
clean
tee -o comparator_benchmark/reports/tree_generic_stats.txt stat
write_json comparator_benchmark/reports/tree_generic.json
